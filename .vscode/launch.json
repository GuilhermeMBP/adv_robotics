{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "args": [
                "--ros-args",
                "-p",
                "use_sim_time:=True",
                "-r",
                "__ns:=/robot_0"
            ]
        },
        {
            // Configuration for debugging a ROS2 C++ node
            // Make sure you compiled with:
            //  colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug
            "name": "Debug ROS2 CPP Node",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/ar_cpp_utils/lib/ar_cpp_utils/sim_control",
            "args": [
            //    "src/worlds/stage_worlds/lw2_new_new.world",
                "--ros-args",
                "--log-level", "INFO",
                "-r", "__ns:=/robot_0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "AMENT_PREFIX_PATH",
                    "value": "/opt/ros/humble"
                },
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "setupCommands": [
                {
                "description": "Enable pretty printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "externalConsole": false,
            // "preLaunchTask": "colcon build" // Manual build before debugging
        },
        {
            // Make sure you run export DEBUGINFOD_URLS="" in the terminal before
            "name": "Attach to ROS2 Node",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/bin/gdb",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "set auto-solib-add off" },
                { "text": "set stop-on-solib-events 0" }
            ]
        }
    ]
}
