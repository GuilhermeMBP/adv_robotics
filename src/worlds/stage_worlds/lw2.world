# Charging locations
define charge_location model
(
  boundary 0
  gui_move 0
  gui_nose 0
  obstacle_return 0
  ranger_return 0
  forklift_return 0
  bitmap "part.png"
  size [0.50 0.50 0.001]
  color "blue"
)

# Charging station 1
charge_location(
  name "charger1"
  pose [-4.8 -2.3 0 0]
)

# Charging station 2
charge_location(
  name "charger2"
  pose [0 -2.8 0 0]
)

# Charging station 3
charge_location(
  name "charger3"
  pose [4.8 -2.0 0 0]
)