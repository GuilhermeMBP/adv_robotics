# Factory World (setup similar to the one used in the Portuguese Robotics Open)
# Authors: Hugo Costelha
# 03/04/2017

include "pioneer.inc" # File with Pioneer models
include "map.inc" # File with map definition
include "sick_long_range.inc" # File for the sick laser

# Simulation setup
resolution 0.02 # Resolution of the underlying ray-trace model
threads 1 # Set this to the number of CPUs for increased simulation speed

# configure the GUI window
window
(
  size [ 635.000 666.000 ] # in pixels
  scale 37.481   # pixels per meter
  center [ 0  0 ]
  rotate [ 0  0 ]

  show_data 1              # 1=on 0=off
)

# load an environment bitmap
floorplan
( 
  name "lw1_scene"
  size [16.000 16.000 0.400]
  pose [0 -0.05 0 0]
  bitmap "lw1_scene.png"
  color "tan3"
  ranger_return 0
)


#pioneer3dx
pioneer2dx_base_no_sonar
(
  # can refer to the robot by this name
  name "robot0"
  # Initial pose
#  pose [ -2 3 0 0 ] # Initial posture
  pose [ 0 0 0 0 ] # Initial posture

  # pioneer3dx's sonars, will be ranger:0 and the laser will be ranger:1
  sicklaser360( pose [ 0 0 0 0 ] ) 

  # To simulate the parts detection
  fiducial
  (
    # fiducialfinder properties
    range_min 0.0
    range_max 1.0
    range_max_id 6.0
    fov 70
    ignore_zloc 1

    # mode properties
    size [0 0 0]
  )

  forklift (
    pose [0.30 0.0 -0.21 0]
    color "gray"
    paddle_size [ 0.20 0.04 0.02 ]
    paddle_state [ "down" ]
    
    size [0.24 0.14 0.06]
  )

  # Uncomment if you want the robot to wander alone without your code
  #ctrl "wander"

  # Use "gps" for error-free position in world coordinates, and "odom" for
  # odometry with uniform random distributed error
  localization "odom"
  localization_origin [ 0 0 0 0 ]
  odom_error [ 0.1 0.03 0 0.2 ] # [ X Y Z Theta ]
)

define boxBase model
(
  gui_move 1
  gui_nose 0
  obstacle_return 0
  ranger_return 0.8
  forklift_return 1
  bitmap "part.png"
)

define box_with_feet position
(
  gui_move 1
  gui_nose 0
  obstacle_return 1
  ranger_return 0.8
  forklift_return 1
  fiducial_return 1

  origin [0 0 0 0]
  size [0.1 0.25 0.15]
  z [0.04 0.19 ]
  bitmap "part.png"
  color "blue"

  # Top-right leg
  boxBase( 
    pose [0.04 0.115 -0.19 0]
    size [0.02 0.02 0.04]
    color "black"
  )

  # Top-leftight leg
  boxBase( 
    pose [-0.04 0.115 -0.19 0]
    size [0.02 0.02 0.04]
    color "black"
  )

  # Bottom-left leg
  boxBase( 
    pose [-0.04 -0.115 -0.19 0]
    size [0.02 0.02 0.04]
    color "black"
  )

  # Bottom-right leg
  boxBase( 
    pose [0.04 -0.115 -0.19 0]
    size [-0.02 0.02 0.04]
    color "black"
  )

)

box_with_feet (
  name "box1"
  pose [-4.90 -7.00 0.04 90.00]  # x y z heading
)

box_with_feet (
  name "box2"
  pose [-2.45 -7.00 0.04 90.00]  # x y z heading
)

box_with_feet (
  name "box3"
  pose [0.00 -7.00 0.04 90.00]  # x y z heading
)

box_with_feet (
  name "box4"
  pose [2.45 -7.00 0.04 90.00]  # x y z heading
)

box_with_feet (
  name "box5"
  pose [4.90 -7.00 0.04 90.00]  # x y z heading
)

